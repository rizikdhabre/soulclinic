# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/

# local development documentation
/docs/
!/docs/
/docs/*
!/docs/SEO.md
!/docs/SEO-MEDICAL-REVIEW.md
!/tests/
/tests/*
!/tests/seo/
/tests/seo/artifacts/
!/tests/returnReminders/
/tests/returnReminders/*
!/tests/returnReminders/*.test.js
!/tests/e2e/
/tests/e2e/*
!/tests/e2e/returnReminders/
/tests/e2e/returnReminders/*
!/tests/e2e/returnReminders/*.spec.cjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
